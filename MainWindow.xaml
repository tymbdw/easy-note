<Window x:Class="DesktopNote.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="易便签"
        Width="376" SizeToContent="Height" MaxHeight="820"
        WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        FontFamily="Aptos, Microsoft YaHei UI" FontSize="13"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal">

    <Window.Resources>
        <SolidColorBrush x:Key="TextPrimary" Color="#FF182633"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#FF5B7185"/>
        <SolidColorBrush x:Key="InkSoft" Color="#FF3E566B"/>
        <SolidColorBrush x:Key="DoneText" Color="#FF5F7488"/>
        <SolidColorBrush x:Key="Accent" Color="#FF2899D6"/>

        <SolidColorBrush x:Key="StrokeStrong" Color="#8FFFFFFF"/>
        <SolidColorBrush x:Key="StrokeSoft" Color="#26425D70"/>
        <SolidColorBrush x:Key="Divider" Color="#3342596F"/>
        <SolidColorBrush x:Key="ButtonFill" Color="#16FFFFFF"/>
        <SolidColorBrush x:Key="PanelFill" Color="#22FFFFFF"/>
        <SolidColorBrush x:Key="TrackFill" Color="#20425D70"/>
        <SolidColorBrush x:Key="PrimaryFill" Color="#FF182633"/>
        <SolidColorBrush x:Key="PrimaryText" Color="#FFF6FAFC"/>

        <!-- 玻璃面：左上到右下的白色反光 -->
        <LinearGradientBrush x:Key="CardSurface" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#7CF6FCFF" Offset="0"/>
            <GradientStop Color="#2AFFFFFF" Offset="1"/>
        </LinearGradientBrush>

        <!-- 顶部图标按钮 -->
        <Style x:Key="GlassIconButton" TargetType="Button">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" CornerRadius="13" Background="#14FFFFFF"
                                BorderThickness="1" BorderBrush="#1F5B7185">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#33FFFFFF"/>
                                <Setter TargetName="bg" Property="BorderBrush" Value="#4D5B7185"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#3DFFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 分页面板：胶囊，选中为墨蓝实底 -->
        <Style x:Key="GlassTab" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource InkSoft}"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Margin" Value="0,0,5,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bg" CornerRadius="15" Padding="13,5" Background="Transparent"
                                BorderThickness="1" BorderBrush="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource ButtonFill}"/>
                                <Setter TargetName="bg" Property="BorderBrush" Value="{DynamicResource StrokeSoft}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource PrimaryFill}"/>
                                <Setter TargetName="bg" Property="BorderBrush" Value="Transparent"/>
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 圆形勾选框 -->
        <Style x:Key="GlassCheck" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Width="17" Height="17" Background="Transparent">
                            <Border x:Name="box" CornerRadius="9" BorderThickness="1.3"
                                    BorderBrush="#4D5B7185" Background="#33FFFFFF"/>
                            <Path x:Name="tick" Data="M 4.6,8.8 L 7.4,11.4 L 12.3,5.9"
                                  Stroke="#FFFFFFFF" StrokeThickness="1.7" Visibility="Collapsed"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="box" Property="Background" Value="{DynamicResource Accent}"/>
                                <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                <Setter TargetName="tick" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 极简滚动条 -->
        <Style x:Key="SlimScroll" TargetType="ScrollBar">
            <Setter Property="Width" Value="5"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True"
                                   Minimum="{TemplateBinding Minimum}"
                                   Maximum="{TemplateBinding Maximum}"
                                   Value="{TemplateBinding Value}"
                                   ViewportSize="{TemplateBinding ViewportSize}">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border CornerRadius="2.5" Background="#332899D6" Margin="1,1"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PlainBox" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="CaretBrush" Value="{DynamicResource Accent}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="SelectionBrush" Value="#552899D6"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="AcceptsReturn" Value="False"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- 两层柔光投影，只漏出边缘一圈 halo -->
        <Border CornerRadius="24" Background="#FF0B233A" Opacity="0.40"
                Margin="26,26,26,32" IsHitTestVisible="False">
            <Border.Effect>
                <BlurEffect Radius="30"/>
            </Border.Effect>
            <Border.RenderTransform>
                <TranslateTransform Y="10"/>
            </Border.RenderTransform>
        </Border>
        <Border CornerRadius="24" Background="#FF123E5E" Opacity="0.18"
                Margin="30,30,30,36" IsHitTestVisible="False">
            <Border.Effect>
                <BlurEffect Radius="6"/>
            </Border.Effect>
            <Border.RenderTransform>
                <TranslateTransform Y="2"/>
            </Border.RenderTransform>
        </Border>

        <Border x:Name="Card" Margin="20,20,20,26" CornerRadius="24" BorderThickness="1"
                BorderBrush="#3D42596F" Background="#CCF4F9FF">
            <Grid ClipToBounds="True">
                <Border CornerRadius="23" BorderThickness="1" BorderBrush="#66FFFFFF" Margin="1"
                        IsHitTestVisible="False"/>
                <Border CornerRadius="24" Background="{StaticResource CardSurface}" IsHitTestVisible="False"/>

                <Grid x:Name="RootGrid">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 头部：Georgia 日期 + 图标按钮 -->
                    <Grid Grid.Row="0" Height="68" Background="Transparent"
                          MouseLeftButtonDown="Header_MouseDown">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,2,0,0">
                            <TextBlock x:Name="DayText" Text="26" FontFamily="Georgia" FontSize="26"
                                       Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                            <StackPanel Margin="11,3,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="MonthText" Text="10月" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimary}"/>
                                <TextBlock x:Name="WeekText" Text="周一" FontSize="11" Margin="0,2,0,0"
                                           Foreground="{DynamicResource InkSoft}"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                    VerticalAlignment="Center" Margin="0,2,13,0">
                            <Button x:Name="FoldBtn" Style="{StaticResource GlassIconButton}" Content="▾"
                                    Click="Fold_Click" ToolTip="折叠"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Row="1" Margin="20,0,20,12">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="Tab0" Style="{StaticResource GlassTab}" Content="今日" Tag="0" Checked="Tab_Checked"/>
                            <RadioButton x:Name="Tab1" Style="{StaticResource GlassTab}" Content="本周" Tag="1" Checked="Tab_Checked"/>
                            <RadioButton x:Name="Tab2" Style="{StaticResource GlassTab}" Content="未掌握" Tag="2" Checked="Tab_Checked"/>
                        </StackPanel>
                        <Border Height="1" Background="{DynamicResource Divider}" Margin="0,11,0,0"/>
                    </StackPanel>

                    <ScrollViewer Grid.Row="2" x:Name="ListScroll" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled" Margin="20,2,7,0" Focusable="False" MaxHeight="330">
                        <ScrollViewer.Resources>
                            <Style TargetType="ScrollBar" BasedOn="{StaticResource SlimScroll}"/>
                        </ScrollViewer.Resources>
                        <ItemsControl x:Name="ListHost">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="RowBg" CornerRadius="9" Padding="0,3" Margin="0,1"
                                            Background="Transparent">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <CheckBox Grid.Column="0" Style="{StaticResource GlassCheck}"
                                                      IsChecked="{Binding Done, Mode=TwoWay}"
                                                      VerticalAlignment="Top" Margin="0,3,9,0"/>
                                            <TextBox Grid.Column="1" x:Name="ItemText" Style="{StaticResource PlainBox}"
                                                     Text="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     KeyDown="Item_KeyDown" MinHeight="21" Padding="0,1,0,2">
                                                <TextBox.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Header="删除这一条" Click="DeleteItem_Click"/>
                                                    </ContextMenu>
                                                </TextBox.ContextMenu>
                                            </TextBox>
                                            <Button x:Name="RowDel" Grid.Column="2" Content="✕" Width="16" Height="16"
                                                    Opacity="0" Cursor="Hand" FontSize="8.5" Focusable="False"
                                                    Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Top"
                                                    Margin="2,3,0,0" Click="RowDel_Click" ToolTip="删除">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="d" CornerRadius="8" Background="Transparent">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="d" Property="Background" Value="#33FFFFFF"/>
                                                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <Trigger SourceName="RowBg" Property="IsMouseOver" Value="True">
                                            <Setter TargetName="RowBg" Property="Background" Value="#16FFFFFF"/>
                                            <Setter TargetName="RowDel" Property="Opacity" Value="1"/>
                                        </Trigger>
                                        <DataTrigger Binding="{Binding Done}" Value="True">
                                            <Setter TargetName="ItemText" Property="Foreground" Value="{DynamicResource DoneText}"/>
                                            <Setter TargetName="ItemText" Property="Opacity" Value="1"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <StackPanel Grid.Row="3">
                        <Border Height="1" Background="{DynamicResource Divider}" Margin="20,2,20,0"/>
                        <Grid Margin="20,11,20,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="17" Height="17" CornerRadius="9" Margin="0,0,9,0"
                                    BorderThickness="1.2" BorderBrush="#4D5B7185" Background="#22FFFFFF"
                                    VerticalAlignment="Center" IsHitTestVisible="False">
                                <TextBlock Text="＋" FontSize="10.5" Foreground="{DynamicResource Accent}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Margin="0,0,0,1.5"/>
                            </Border>
                            <Grid Grid.Column="1">
                                <TextBox x:Name="AddBox" Style="{StaticResource PlainBox}" Padding="0,2"
                                         FontSize="12.5" KeyDown="AddBox_KeyDown" LostKeyboardFocus="AddBox_LostFocus"/>
                                <TextBlock x:Name="AddHint" Text="记一条…" Foreground="{DynamicResource TextSecondary}"
                                           IsHitTestVisible="False" VerticalAlignment="Center" FontSize="12.5"
                                           Opacity="0.85"/>
                            </Grid>
                        </Grid>
                    </StackPanel>

                    <Grid Grid.Row="4" Margin="20,11,20,16">
                        <TextBlock x:Name="StatusText" Text="自动保存" Foreground="{DynamicResource InkSoft}"
                                   FontSize="9.5" Opacity="0.9" VerticalAlignment="Center"/>
                        <TextBlock x:Name="CountText" Text="" Foreground="{DynamicResource Accent}"
                                   FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
